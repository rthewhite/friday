{
  "name": "@friday/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Friday server: HTTP, audio WebSocket, Gemini Live session, module host.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:coverage": "c8 --all --src src --include 'src/**' --exclude 'src/**/*.d.ts' --exclude 'src/modules.gen.ts' --reporter text --clean node --import tsx --test test/*.test.ts",
    "test:live": "node --import tsx scripts/test-live.ts"
  },
  "dependencies": {
    "@friday/module-brain": "workspace:*",
    "@friday/module-builtin": "workspace:*",
    "@friday/module-calendar": "workspace:*",
    "@friday/module-media": "workspace:*",
    "@friday/module-sonos": "workspace:*",
    "@friday/module-spotify": "workspace:*",
    "@friday/module-travel": "workspace:*",
    "@friday/sdk": "workspace:*",
    "@google/genai": "^2.24.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "arctic": "~3.7.0",
    "dotenv": "^18.0.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
