{
  "name": "@friday/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Friday module contract: manifest, module context, tool registry and a test host.",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./test": { "types": "./dist/test.d.ts", "default": "./dist/test.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  }
}
