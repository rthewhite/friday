{
  "name": "@friday/portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Friday portal: Vue shell hosting the voice client, module list and module UIs.",
  "scripts": {
    "gen": "node scripts/gen-modules.mjs",
    "dev": "pnpm gen && vite",
    "build": "pnpm gen && vite build",
    "typecheck": "pnpm gen && vue-tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.mjs test/*.test.ts && vitest run",
    "test:coverage": "c8 node --import tsx --test test/*.test.mjs test/*.test.ts && vitest run --coverage --coverage.include=src/**"
  },
  "dependencies": {
    "@friday/module-brain": "workspace:*",
    "@friday/module-calendar": "workspace:*",
    "@friday/module-media": "workspace:*",
    "@friday/portal-ui": "workspace:*",
    "markdown-it": "^15.0.2",
    "vue": "^3.5.29",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "3.2.7",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.8.1",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "3.2.7",
    "vue-tsc": "^3.2.5"
  },
  "friday": {
    "workspaceRoot": "../.."
  }
}
