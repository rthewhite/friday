{
  "name": "@friday/portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Friday portal: Vue shell hosting the voice client, module list and module UIs.",
  "scripts": {
    "gen": "node scripts/gen-modules.mjs",
    "dev": "pnpm gen && vite",
    "build": "pnpm gen && vite build",
    "typecheck": "pnpm gen && vue-tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@friday/module-media": "workspace:*",
    "@friday/portal-ui": "workspace:*",
    "vue": "^3.5.29",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.8.1",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1",
    "vue-tsc": "^3.2.5",
    "typescript": "~5.9.3"
  },
  "friday": {
    "workspaceRoot": "../.."
  }
}
