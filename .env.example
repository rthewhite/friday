GEMINI_API_KEY=your-key-here
# FRIDAY_MODEL=gemini-3.8-live
# FRIDAY_PORT=8080
# Only load these in-process modules (comma-separated ids; default: all in packages/core/src/modules.ts)
# FRIDAY_MODULES=builtin,media
# Directory the built portal is served from (default: packages/portal/dist)
# FRIDAY_WEB_DIR=
# Where friday.db lives (encrypted configuration, remote module keys, module storage). Default ./data
# FRIDAY_DATA_DIR=./data
# Conversations are kept in friday.db as transcript text (never audio). Delete those whose last activity is
# older than this many days, nightly at 04:00 (0 keeps them forever)
# FRIDAY_CONVERSATION_RETENTION_DAYS=90
# A conversation goes quiet after this many minutes without activity (a voice conversation when its session closes)
# FRIDAY_CONVERSATION_QUIET_MINUTES=30
# Encrypts configuration values saved in the portal (Settings > Configuration). 32 bytes, base64:
#   openssl rand -base64 32
# Without it the store is disabled and only environment values are used.
# FRIDAY_MASTER_KEY=
# Remote modules (/ws/modules). Prefer keys issued in the portal (Settings > Remote modules);
# this env fallback still works as <id>=<key> pairs.
# FRIDAY_MODULE_KEYS=simracing=change-me
# Give a remote module this long to answer a tool call before the model hears "timeout"
# FRIDAY_REMOTE_CALL_TIMEOUT_MS=10000
# FRIDAY_VOICE=Aoede
# Close the session after this many ms of silence following a turn (0 = never)
# FRIDAY_IDLE_TIMEOUT_MS=8000
# Ping WebSocket clients this often and drop ones that stop answering (0 = never)
# FRIDAY_WS_PING_MS=20000
# Gemini start-of-speech detection: LOW (default; ignores faint echo on speaker devices) or HIGH
# FRIDAY_VAD_START_SENSITIVITY=LOW
# Speech must last this many ms before it counts as the user talking / interrupting
# FRIDAY_VAD_PREFIX_MS=200
# Log what Gemini hears the user say (debugging echo / barge-in); 1 to enable
# FRIDAY_LOG_TRANSCRIPTS=0

# Default zone for get_current_time (module builtin)
# FRIDAY_TIMEZONE=Europe/Amsterdam

# Jellyfin + Apple TV (module media). These can be set in the portal instead (Settings > Configuration);
# stored values win over the environment. JELLYFIN_URL and JELLYFIN_API_KEY are required for the module to load.
# JELLYFIN_URL=http://jellyfin.local:8096
# JELLYFIN_API_KEY=
# JELLYFIN_USER=
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=
# HA_APPLE_TV_ENTITY=media_player.living_room
